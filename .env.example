PAYMENT_OPS_INTERNAL_KEY=change-me-internal
AGENT_API_KEY=change-me-agent
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Development: 1.0 retains all traces for end-to-end verification.
# Production: start with 0.1 and tune to telemetry budget; sampling is probabilistic.
TRACING_SAMPLING_PROBABILITY=1.0

# Tempo local-block retention (development default 48h); requires Tempo recreation.
TEMPO_BLOCK_RETENTION=48h
